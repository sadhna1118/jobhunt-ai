# Application Environment Configuration
# Copy this file to .env and fill in your values

# ===== APPLICATION =====
APP_NAME=JobhuntAI
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
TIMEZONE=Asia/Kolkata

# ===== DATABASE =====
DATABASE_URL=postgresql://jobhunt_user:jobhunt_password@localhost:5432/jobhunt_ai
DATABASE_ECHO=true
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# ===== REDIS =====
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=

# ===== FRONTEND =====
FRONTEND_URL=http://localhost:3000
FRONTEND_PROD_URL=https://jobhunt-ai.vercel.app

# ===== BACKEND =====
BACKEND_URL=http://localhost:8000
BACKEND_PROD_URL=https://api.jobhunt-ai.com

# ===== CORS =====
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8000"]

# ===== API KEYS & CREDENTIALS =====

# OpenAI
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_MODEL=gpt-4
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Google Gemini
GEMINI_API_KEY=your-gemini-key-here
GEMINI_MODEL=gemini-1.5-pro

# ===== OAUTH CONFIGURATIONS =====

# LinkedIn OAuth (for future API access)
LINKEDIN_CLIENT_ID=your-client-id
LINKEDIN_CLIENT_SECRET=your-client-secret
LINKEDIN_REDIRECT_URI=http://localhost:8000/api/auth/linkedin/callback

# Gmail OAuth
GMAIL_CLIENT_ID=your-client-id
GMAIL_CLIENT_SECRET=your-client-secret
GMAIL_REDIRECT_URI=http://localhost:8000/api/auth/gmail/callback

# Naukri Integration (if API available)
NAUKRI_API_KEY=your-api-key
NAUKRI_API_SECRET=your-api-secret

# Internshala Integration (if API available)
INTERNSHALA_API_KEY=your-api-key
INTERNSHALA_API_SECRET=your-api-secret

# ===== AUTOMATION SETTINGS =====

# Scheduling
AUTOMATION_ENABLED=true
MORNING_RUN_TIME=05:00
EVENING_RUN_TIME=21:00
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Limits
DAILY_APPLICATION_LIMIT=10
DAILY_EMAIL_LIMIT=5
MIN_MATCH_SCORE=75
RECRUITER_RECONTACT_DAYS=30

# Job Search
JOB_SEARCH_ENABLED_SOURCES=["linkedin", "naukri", "internshala"]
TARGET_JOB_TYPES=["internship", "fresher"]
TARGET_LOCATIONS=[]

# ===== EMAIL CONFIGURATION =====

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=noreply@jobhunt-ai.com
EMAIL_FROM_NAME=JOBHUNT AI

# ===== TELEGRAM NOTIFICATIONS (Optional) =====

TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=your-bot-token
TELEGRAM_CHAT_ID=your-chat-id

# ===== BROWSER AUTOMATION =====

# Playwright
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_TIMEOUT=30000
PLAYWRIGHT_SLOW_MO=0

# ===== DEMO MODE =====

DEMO_MODE=false
DEMO_JOB_COUNT=100
DEMO_RECRUITER_COUNT=50

# ===== SECURITY =====

# JWT
JWT_SECRET=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
JWT_REFRESH_EXPIRATION_DAYS=7

# CSRF
CSRF_ENABLED=true
CSRF_TRUST_ORIGINS=["http://localhost:3000"]

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60

# ===== FILE UPLOAD =====

MAX_UPLOAD_SIZE_MB=5
UPLOAD_DIR=./uploads
ALLOWED_RESUME_EXTENSIONS=["pdf", "docx", "doc"]

# ===== AUDIT & LOGGING =====

AUDIT_LOGGING_ENABLED=true
AUDIT_LOG_RETENTION_DAYS=90
SENTRY_DSN=

# ===== INTEGRATION SECRETS =====

# Secure password (never use in code)
CANDIDATE_PROFILE_ENCRYPTION_KEY=your-32-char-encryption-key-here

# ===== DEVELOPMENT =====

TESTING=false
SEED_DATABASE=false
SEED_DEMO_DATA=false

# ===== PRODUCTION =====

SECURE_COOKIES=true
SECURE_HSTS=true
SECURE_HSTS_MAX_AGE=31536000
